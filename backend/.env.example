# Copy to backend/.env and fill in real values. Never commit backend/.env.

# Core
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=sqlite:///./saarthi.db
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI provider: gemma | gemini | openai | mock
# Keep mock for offline deterministic rules. Use gemma for Gemma 4 inference.
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=1

# Gemma 4 (self-hosted OpenAI-compatible vLLM/Ollama endpoint)
# Example: http://127.0.0.1:8000/v1
# Model identifiers: google/gemma-4-12B-it or google/gemma-4-31B-it
GEMMA_BASE_URL=
GEMMA_API_KEY=
GEMMA_MODEL=google/gemma-4-12B-it

# Gemma 4 via Gemini API (used only when GEMMA_BASE_URL is empty)
# Hosted model identifiers: gemma-4-31b-it or gemma-4-26b-a4b-it
GEMINI_API_KEY=
GEMMA_GEMINI_MODEL=gemma-4-26b-a4b-it

# Only enable for a hosted endpoint if you accept sending raw documents off-device.
GEMMA_ALLOW_DOCUMENT_BYTES=false

# Optional alternative providers
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg
